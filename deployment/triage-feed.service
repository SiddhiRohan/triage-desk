[Unit]
Description=Triage Desk Feed Processor
After=triage.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/triage-desk
Environment=CONFIDENCE_THRESHOLD=0.70
Environment=TRIAGE_MODEL=gpt-oss:20b
EnvironmentFile=/home/ubuntu/triage-desk/.env
ExecStart=/home/ubuntu/triage-desk/.venv/bin/python scripts/run_feed.py

[Install]
WantedBy=multi-user.target
